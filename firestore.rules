// Enforces role-based access control (RBAC), user document ownership, and task state restrictions.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Check if the request is from an authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the authenticated user matches the target user ID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check if the authenticated user has administrative privileges
    function isAdmin() {
      return isAuthenticated() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin'
      );
    }

    // Users collection: owner can write, authenticated users can read
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if false;
    }

    // Tasks collection: RBAC for creation, assignment, updates, and cancellation
    match /tasks/{taskId} {
      allow read: if isAuthenticated();

      // Only authenticated patients can create tasks under their own patient ID
      allow create: if isAuthenticated() &&
        request.resource.data.patientId == request.auth.uid;

      // Updates allowed for task owner, assigned helper, accepting helper, or admin
      allow update: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.assignedHelperId == request.auth.uid ||
        (resource.data.assignedHelperId == null && request.resource.data.assignedHelperId == request.auth.uid) ||
        isAdmin()
      );

      // Task deletion only allowed by patient if task is still pending or admin
      allow delete: if isAuthenticated() && (
        (resource.data.patientId == request.auth.uid && resource.data.progressStep == 'pending') ||
        isAdmin()
      );
    }

    // Payments collection: patient creates on task creation; helper, patient, and admin can read
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.helperId == request.auth.uid ||
        resource.data.helperId == null ||
        isAdmin()
      );
      // Patients create the initial payment record when creating a task
      allow create: if isAuthenticated() &&
        request.resource.data.patientId == request.auth.uid;
      // Authenticated users or admins can update payment records
      allow update: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.helperId == request.auth.uid ||
        resource.data.helperId == null ||
        isAdmin()
      );
      allow delete: if false;
    }

    // Task Assignments collection: authenticated users involved in the task or admins can read and write
    match /task_assignments/{assignmentId} {
      allow read: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.helperId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.helperId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if false;
    }

    // Payouts collection: helpers can create and read their own payout requests; admins can process
    match /payouts/{payoutId} {
      allow read: if isAuthenticated() && (
        resource.data.helperId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() &&
        request.resource.data.helperId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Support Tickets collection: users can read/create their own tickets; admins have full read/update access
    match /support_tickets/{ticketId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/support_tickets/$(ticketId)).data.userId == request.auth.uid ||
          isAdmin()
        );
        allow create: if isAuthenticated();
        allow update, delete: if false;
      }
    }
  }
}