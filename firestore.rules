// Enforces role-based access control (RBAC), user document ownership, and task state restrictions.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Check if the request is from an authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the authenticated user matches the target user ID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users collection rules: owner can write, authenticated users can read
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    // Tasks collection rules: RBAC for creation, assignment, updates, and cancellation
    match /tasks/{taskId} {
      // Authenticated patients and helpers can read task details
      allow read: if isAuthenticated();

      // Only authenticated patients can create tasks under their own patient ID
      allow create: if isAuthenticated() &&
        request.resource.data.patientId == request.auth.uid;

      // Updates allowed for:
      // 1. The task owner (patient) cancelling or modifying
      // 2. The assigned helper updating task progress
      // 3. A helper accepting an unassigned pending task
      allow update: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.assignedHelperId == request.auth.uid ||
        (resource.data.assignedHelperId == null && request.resource.data.assignedHelperId == request.auth.uid)
      );

      // Task deletion only allowed by patient if task is still pending
      allow delete: if isAuthenticated() &&
        resource.data.patientId == request.auth.uid &&
        resource.data.progressStep == 'pending';
    }
  }
}